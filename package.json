{
  "name": "tcc-modular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "engines": {
    "node": "26.13.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "npm run modules:catalog && concurrently -k 'tsx watch --env-file-if-exists=.env apps/server/src/main.ts' 'vite --config apps/client/vite.config.ts'",
    "modules:catalog": "tsx scripts/catalog.ts",
    "modules:check": "tsx scripts/check-modules.ts",
    "typecheck": "npm run modules:catalog && tsc --noEmit && vue-tsc --noEmit -p apps/client/tsconfig.json",
    "build": "npm run modules:catalog && tsc -p tsconfig.build.json && node scripts/build-packages.mjs && vite build --config apps/client/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/admin.ts migrate",
    "provision": "tsx --env-file-if-exists=.env scripts/admin.ts provision",
    "seed": "tsx --env-file-if-exists=.env scripts/admin.ts seed",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write apps packages modules scripts tests config docs README.md",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "backup": "tsx --env-file-if-exists=.env scripts/admin.ts backup",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.0",
    "@citation-js/plugin-bibtex": "^0.7.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-unique-id": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "idb": "^8.0.0",
    "multer": "^2.0.0",
    "pinia": "^3.0.0",
    "playwright": "^1.55.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
